{
  "$schema": "https://raw.githubusercontent.com/nicerpc/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Knowledge Intelligence",
  "version": "0.1.0",
  "identifier": "com.knowledge-intelligence.app",
  "build": {
    "frontendDist": "../../app/frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "cd /Users/mrh/Documents/Projects/KnowledgeIntelligence/app/frontend && npm run dev",
    "beforeBuildCommand": "cd /Users/mrh/Documents/Projects/KnowledgeIntelligence/app/frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Knowledge Intelligence",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
